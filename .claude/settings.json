{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-writes.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-env-read.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path'); case \"$f\" in *.md) npx markdown-link-check -q \"$f\";; *.go) gofmt -l \"$f\";; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowUnixSockets": [
        "/tmp/.nx",
        "~/.nx"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp/.nx",
        "~/.nx"
      ],
      "allowRead": [
        "/tmp/.nx",
        "~/.nx"
      ]
    }
  }
}
